{
  "name": "song-shiori",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --local",
    "db:migrate:local": "wrangler d1 migrations apply kyoku-shiori --local",
    "build": "tsc --noEmit -p . && vite build",
    "test": "vitest run",
    "deploy:api": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@preact/preset-vite": "^2.10.6",
    "preact": "^11.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  }
}
